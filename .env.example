# Copy this file to ".env" (same folder as docker-compose.yml) and fill
# in real values. Docker Compose reads ".env" automatically - never
# commit the real ".env" file to git.

# Your DuckDNS subdomain (e.g. elecsa.duckdns.org) for real HTTPS, or
# your server's bare IP address if skipping that for now (HTTP only -
# see the deployment notes about what that means for the login page).
SITE_ADDRESS=

# Same three values as backend/.env during local development -
# generate AUTH_PASSWORD_HASH and JWT_SECRET the same way described
# there. Login username for the platform.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
